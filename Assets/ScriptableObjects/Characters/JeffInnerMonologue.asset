MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea275cd15a5c79843935246b501aa0e6, type: 3}
  m_Name: JeffInnerMonologue
  m_EditorClassIdentifier: Assembly-CSharp::SCR_DialogueData
  dialogueID: 
  npcID: 
  dialogueLines:
  - characterName: Jeff
    speakerSide: 0
    dialogueText: The Mayor and the Gas Station Owner... that meeting wasn't normal.
    leftCharacterPortrait: {fileID: 2959228409216872590, guid: 59b2787c69d3dc142a6d9f396ac81334, type: 3}
    rightCharacterPortrait: {fileID: 0}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  - characterName: Jeff
    speakerSide: 0
    dialogueText: A photo isn't enough. I need proof of what they're planning.
    leftCharacterPortrait: {fileID: 2959228409216872590, guid: 59b2787c69d3dc142a6d9f396ac81334, type: 3}
    rightCharacterPortrait: {fileID: 0}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  - characterName: Jeff
    speakerSide: 0
    dialogueText: If there's anything, it'll be inside the Mayor's house. Documents,
      a phone, anything.
    leftCharacterPortrait: {fileID: 2959228409216872590, guid: 59b2787c69d3dc142a6d9f396ac81334, type: 3}
    rightCharacterPortrait: {fileID: 0}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  - characterName: Jeff
    speakerSide: 0
    dialogueText: Alright. Tonight, I'm getting inside the Mayor's house.
    leftCharacterPortrait: {fileID: 2959228409216872590, guid: 59b2787c69d3dc142a6d9f396ac81334, type: 3}
    rightCharacterPortrait: {fileID: 0}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  - characterName: Jeff
    speakerSide: 0
    dialogueText: It's risky. If I get caught, I lose everything. But if I do nothing...
    leftCharacterPortrait: {fileID: 2959228409216872590, guid: 59b2787c69d3dc142a6d9f396ac81334, type: 3}
    rightCharacterPortrait: {fileID: 0}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  nextDialogue: {fileID: 0}
  nameFontSize: 36
