  m_Script: {fileID: 11500000, guid: ea275cd15a5c79843935246b501aa0e6, type: 3}
  m_Name: DLG_Emma_Hospital
  m_EditorClassIdentifier: Assembly-CSharp::SCR_DialogueData
  dialogueID: 
  npcID: 
  dialogueLines:
  - characterName: Jeff
    speakerSide: 0
    dialogueText: The Doctor said that Marielle has Tyroid fever, and that the treatment
      will cost alot
    leftCharacterPortrait: {fileID: 2959228409216872590, guid: 59b2787c69d3dc142a6d9f396ac81334, type: 3}
    rightCharacterPortrait: {fileID: 0}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  - characterName: Emma
    speakerSide: 1
    dialogueText: What are we going to do? I don't think our saving will be enough
      to pay for the treatment
    leftCharacterPortrait: {fileID: 0}
    rightCharacterPortrait: {fileID: -6769428290867566633, guid: d207ff83d56f99547b980d19a25d18ec, type: 3}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  - characterName: Jeff
    speakerSide: 0
    dialogueText: I'll try to get more money from today's work. Can i ask you to
      take care of Marielle in the meantime
    leftCharacterPortrait: {fileID: 2959228409216872590, guid: 59b2787c69d3dc142a6d9f396ac81334, type: 3}
    rightCharacterPortrait: {fileID: 0}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  - characterName: Emma
    speakerSide: 1
    dialogueText: 'Okay. Be safe and take care '
    leftCharacterPortrait: {fileID: 0}
    rightCharacterPortrait: {fileID: -6769428290867566633, guid: d207ff83d56f99547b980d19a25d18ec, type: 3}
    nameFontSize: 36
    nameTextOffsetX: 50
    nameTextOffsetY: 0
  nameFontSize: 36
