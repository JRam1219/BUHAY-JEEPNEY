  interactRange: 4.5
  passengerDialogue:
  - speakerName: STUDENT
    text: UMak lang po. Manong, napansin mo ba? Ang mahal na naman ng gasolina ngayon!
    showChoices: 0
  - speakerName: JEFF
    text: Oo nga eh! Pataas ng pataas.
    showChoices: 0
  - speakerName: STUDENT
    text: Kasi hawak na raw ng mayor halos lahat ng gasolinahan dito sa atin. Wala
      nang ibang mapagpipilian ang mga tao.
    showChoices: 0
  - speakerName: JEFF
    text: Shhhh... Wag ka mag-sasabe ng ganyan sa publiko. Maraming tenga at mata
      ang mayor natin. Sige na sakay kana madami pang bakanteng upuan.
    showChoices: 0
  fareReward: 0
