  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GasAttendantInteractable
  jeepPlayer: {fileID: 1578229335}
  interactRange: 4.5
  refuelDialogue:
  - speakerName: ATTENDANT
    text: Magandang umaga, Boss! Full tank ng diesel?
    showChoices: 0
  - speakerName: JEFF
    text: Oo, sige. Kailangan ko ng sapat para sa buong biyahe sa umaga.
    showChoices: 0
  - speakerName: '[NARRATOR]'
    text: Glug, glug... Puno na ang tangke ng diesel ng jeepney mo.
    showChoices: 0
  - speakerName: ATTENDANT
    text: 'All set na, Boss! '
    showChoices: 0
  afterRefuelDialogue:
  - speakerName: ATTENDANT
    text: Puno ka na, Boss. Ingat sa biyahe!
    showChoices: 0
  refuelDuration: 60
  hasRefueled: 0
