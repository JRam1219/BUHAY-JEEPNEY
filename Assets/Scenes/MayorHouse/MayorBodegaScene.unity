  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogManager
  dialogFrame: {fileID: 2008757170}
  dialogText: {fileID: 493203532}
  nextButton: {fileID: 1927097965}
  mayorsTrueColor:
  - 'Mayor: You''re awake!'
  - 'Mayor: Tell me, what is it do you wan''t?'
  - 'Jeff: I''m not telling you anything!  '
  - 'Mayor: You know?'
  - 'Mayor: Could you tell me more about Marielle?'
  - 'Jeff: You!'
  - 'Jeff: Don''t you dare!'
  - 'Jeff: If you touch a single bit of her, you''ll pay!'
  - 'Mayor: <i>*Laughs</i>'
  - 'Mayor: I know you''re not the type to risk your family.'
  - 'Mayor: I also know you took a picture of me at the gas station.'
  - 'Mayor: So better cough it up Jeff '
  - 'Mayor: You don''t wanna know what this hand could do. '
  - 'Jeff: <i>Groan in anger</i>'
  - 'Mayor: I know you heard me at the hospital earlier.'
  - 'Mayor: So maybe it''ll help to remember that I could kill Marielle with ease.'
  - 'Mayor: Do you know how easy it is to fool the people? '
  - 'Mayor: Treat the issue as insufficient funds for you and people will forget
    about it easily.  '
  - 'Mayor: People easily judge, hence rendering their thinking capacity useless. '
  - 'Mayor: Maybe that''s how I stayed this long. '
  - 'Mayor: You all are busy fighting each other than looking at the government that
    controls things. '
  - 'Jeff: Okay!  '
  - 'Jeff: I just want....  '
  - <i> Karding entered</i>
  jeffTheSaviour:
  - <i>*Karding attemps to hit the guard</i>
  - '<i>*Minigame: Hit the guard</i>'
  - <i>*Overlap or align the moving column to the stationary red column! </i>
  - <i>*Goodluck!</i>
  meetMarielle: []
  dialogueLines: []
  currentLine: 0
  isDialogActive: 0
